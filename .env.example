# Supabase プロジェクト設定 (Supabaseダッシュボード > Project Settings > API から取得)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側のみで使用。管理者API操作などに使用。絶対にクライアントに公開しない
SUPABASE_SERVICE_ROLE_KEY=

# Google Books API (任意。未設定でもOpenBDのみで動作)
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# アプリのベースURL (メール内リンクなどに使用)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
